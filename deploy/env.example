# LinguaDE 部署环境变量示例（复制为 .env 后填写；不要提交真实密钥）
# 说明：全部留空时系统依然完整可用 —— 前端走「浏览器直连大模型 / 离线规则引擎」，后端只做数据同步。

# ---- 公网入口（比赛/演示默认 HTTP 8080，无需证书）----
LINGUADE_HTTP_PORT=8080
# 备案与证书就绪后改为 nginx.conf，并挂载 deploy/certs
LINGUADE_NGINX_CONF=nginx.http.conf

# ---- 华为云大模型（MaaS / ModelArts Studio，OpenAI 兼容）----
LINGUADE_LLM_BASE_URL=
LINGUADE_LLM_API_KEY=
LINGUADE_LLM_MODEL=deepseek-chat
# 接口类型：openai（Bearer，自动补 /chat/completions）/ azure（api-key + deployment）/ custom（完整地址原样请求）
LINGUADE_LLM_API_STYLE=openai
# 仅 azure 使用
LINGUADE_LLM_API_VERSION=2024-02-15-preview

# ---- 昇腾 AI 云服务：Whisper 语音识别推理服务 ----
LINGUADE_ASR_BASE_URL=
# 自建服务若开了鉴权，填访问 Key；没有就留空
LINGUADE_ASR_API_KEY=

# ---- 华为云 OCR 手写识别（可选，先识别再交大模型批改）----
# 四项填齐才启用；失败自动回落「视觉大模型直接读图」
# Endpoint 例：https://ocr.cn-north-4.myhuaweicloud.com（区域要与 Project ID 一致）
LINGUADE_OCR_BASE_URL=
LINGUADE_OCR_PROJECT_ID=
LINGUADE_OCR_AK=
LINGUADE_OCR_SK=

# ---- 发音合成 TTS（可选，词表/例句无实人录音时补发音）----
# off（默认，前端回落浏览器 TTS）/ siliconflow（语言 API Key，德语可用）/ hwcloud（SIS，中英文音色）/ voxcpm（自建 VoxCPM2，零凭据）
LINGUADE_TTS_CHANNEL=off
# siliconflow：语言 API Key（sk- 开头）；语音模型默认 heygen/heygen-voice-1-turbo（免费至 2026-11-30，失效自动降级 CosyVoice2）
LINGUADE_SILICONFLOW_API_KEY=
LINGUADE_SILICONFLOW_TTS_MODEL=heygen/heygen-voice-1-turbo
# HeyGen 音色为 UUID voice_id（10 个默认音色见模型页「API」标签）；留空直接走 CosyVoice2 兜底音色
LINGUADE_SILICONFLOW_TTS_VOICE=
# hwcloud：SIS 语音合成；AK/SK 与 Project ID 复用上面 OCR 的（账号级 IAM 凭证）
# Endpoint 例：https://sis-ext.cn-north-4.myhuaweicloud.com
LINGUADE_TTS_SIS_ENDPOINT=
LINGUADE_TTS_SIS_PROPERTY=chinese_xiaoyu_common
# voxcpm：自建 vLLM-Omni / Nano-vLLM 部署的 VoxCPM2（零商业凭据，德语自带；本地自建无需 key）
#   服务端：vllm serve openbmb/VoxCPM2 --omni --port 8000
LINGUADE_VOXCPM_BASE_URL=http://127.0.0.1:8000
LINGUADE_VOXCPM_API_KEY=
LINGUADE_VOXCPM_MODEL=openbmb/VoxCPM2
LINGUADE_VOXCPM_VOICE=

# ---- 数据层：默认 SQLite 写在容器 /data（compose 已把 ./data 挂到宿主，重建不丢）----
# 留空即可用持久化默认值；若要显式写出，必须用四个斜杠的绝对路径
# LINGUADE_DATABASE_URL=sqlite+aiosqlite:////data/linguade.db
# LINGUADE_DATABASE_URL=postgresql+asyncpg://user:pass@<rds-host>:5432/linguade

# ---- 缓存：留空则使用进程内缓存；配置后走高华为云 Redis ----
LINGUADE_REDIS_URL=

# ---- 跨域（nginx 同源反代时可保持默认 *，或收紧为演示域名）----
LINGUADE_CORS_ORIGINS=*

# ---- 账号体系 ----
# 邀请码：注册时必须填写；留空则关闭注册（只能登录已有账号）
# 生成：openssl rand -hex 10  →  前面加 LD- 之类前缀更好认
LINGUADE_INVITE_CODE=
# 该用户名注册后自动获得管理员权限（可进「设置 → 系统设置」）
LINGUADE_ADMIN_USER=owner
# 登录会话有效期（天）
LINGUADE_SESSION_DAYS=7
# HTTPS 部署时置 1：会话 Cookie 加 Secure（HTTP 部署保持 0，否则浏览器不会保存登录态）
LINGUADE_COOKIE_SECURE=0
# AI 配额：按账号滚动 24 小时 / 每分钟（单进程内存计数；多 worker 时需换 Redis）
LINGUADE_AI_DAILY_LIMIT=200
LINGUADE_AI_MINUTE_LIMIT=12